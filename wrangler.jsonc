{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-amin",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e73b2e19-b9da-4a3c-b0a2-96546b208992","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9c6f5c365e8943a68c033f78e8015b93" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
